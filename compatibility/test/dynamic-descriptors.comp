#version 450
#ifndef OUTPUT_SET
#define OUTPUT_SET 1
#endif
layout(local_size_x=1) in;
layout(set=0,binding=3,std430) readonly buffer Input {uint value;} source[2];
layout(set=0,binding=7,std140) uniform Params {uvec4 value;} params[2];
layout(set=OUTPUT_SET,binding=2,std140) uniform Extra {uvec4 value;} extra;
layout(set=OUTPUT_SET,binding=9,std430) buffer Output {uint value;} result[2];
void main(){
    result[0].value=source[0].value+3*source[1].value+5*params[0].value.x+7*params[1].value.x+11*extra.value.x;
    result[1].value=source[0].value^source[1].value^params[0].value.x^params[1].value.x^extra.value.x;
}
