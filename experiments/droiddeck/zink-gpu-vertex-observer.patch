+      for (unsigned i = 0; i < num_buffers; i++) {
+         if (buffers[i].is_user_buffer || !buffers[i].buffer.resource)
+            continue;
+         for (unsigned m = 0; m < ARRAY_SIZE(tr_ctx->mavk_maps); m++) {
+            unsigned offset = buffers[i].buffer_offset;
+            if (!tr_ctx->mavk_maps[m].map ||
+                tr_ctx->mavk_maps[m].resource != buffers[i].buffer.resource ||
+                offset < tr_ctx->mavk_maps[m].offset ||
+                offset - tr_ctx->mavk_maps[m].offset >= tr_ctx->mavk_maps[m].size)
+               continue;
+            unsigned relative = offset - tr_ctx->mavk_maps[m].offset;
+            unsigned size = MIN2(160, tr_ctx->mavk_maps[m].size - relative);
+            const unsigned char *data = tr_ctx->mavk_maps[m].map + relative;
+            fprintf(stderr, "MAVK_VERTEX_SNAPSHOT sample=%u binding=%u resource=%p offset=%u bytes=%u hex=",
+                    sample, i, (void *)buffers[i].buffer.resource, offset, size);
+            for (unsigned b = 0; b < size; b++)
+               fprintf(stderr, "%02x", data[b]);
+            fprintf(stderr, "\n");
+            if (sample == 3 && debug_get_bool_option("MAVK_TRACE_GPU_VERTEX_COPY", false)) {
+               unsigned char expected[160];
+               memcpy(expected, data, size);
+               mavk_observe_gpu_copy(pipe, buffers[i].buffer.resource, offset, size, expected, sample, i, false);
+               if (i == 0) {
+                  struct pipe_resource *control = pipe_buffer_create(pipe->screen, PIPE_BIND_VERTEX_BUFFER,
