#version 450
layout(local_size_x=64) in;
#ifdef MAVK_CUBE_IMAGE
#ifndef MAVK_FILTERED_IMAGE
#error Cube sampling requires the explicit LOD fixture
#endif
layout(set=0,binding=0) uniform samplerCube sampledImage[2];
#elif defined(MAVK_VOLUME_IMAGE)
layout(set=0,binding=0) uniform sampler3D sampledImage[2];
#elif defined(MAVK_ARRAY_IMAGE)
layout(set=0,binding=0) uniform sampler2DArray sampledImage[2];
#else
layout(set=0,binding=0) uniform sampler2D sampledImage[2];
#endif
#ifdef MAVK_VOLUME_STORAGE
layout(set=0,binding=1,r32ui) uniform uimage3D storageImage[2];
#else
layout(set=0,binding=1,r32ui) uniform uimage2D storageImage[2];
#endif
layout(set=0,binding=2,std430) buffer Results { uint value[768]; } results;
void main(){
    uint i=gl_GlobalInvocationID.x;
    ivec2 xy=ivec2(i%8,i/8);
#if defined(MAVK_ARRAY_IMAGE) || defined(MAVK_VOLUME_IMAGE)
    ivec3 uv=ivec3(xy,int(i%2));
#else
    ivec2 uv=xy;
#endif
#ifdef MAVK_FILTERED_IMAGE
#ifdef MAVK_CUBE_IMAGE
    const vec3 directions[6]=vec3[6](vec3(1,0,0),vec3(-1,0,0),vec3(0,1,0),vec3(0,-1,0),vec3(0,0,1),vec3(0,0,-1));
    vec3 coordinate=directions[i%6];
#elif defined(MAVK_VOLUME_IMAGE)
    vec3 coordinate=vec3((vec2(xy)+vec2(0.5))/8.0,(float(i%2)+0.5)/2.0);
#elif defined(MAVK_ARRAY_IMAGE)
    vec3 coordinate=vec3((vec2(xy)+vec2(0.5))/8.0,float(i%2));
#else
    vec2 coordinate=(vec2(xy)+vec2(0.5))/8.0;
#endif
    uvec4 a=uvec4(round(textureLod(sampledImage[0],coordinate,0.0)*255.0));
    uvec4 b=uvec4(round(textureLod(sampledImage[1],coordinate,0.0)*255.0));
#else
    uvec4 a=uvec4(round(texelFetch(sampledImage[0],uv,0)*255.0));
    uvec4 b=uvec4(round(texelFetch(sampledImage[1],uv,0)*255.0));
#endif
#ifdef MAVK_VOLUME_STORAGE
    ivec3 storageCoordinate=ivec3(xy,0);
#else
    ivec2 storageCoordinate=xy;
#endif
    uint x=imageLoad(storageImage[0],storageCoordinate).x;
    uint y=imageLoad(storageImage[1],storageCoordinate).x;
    imageStore(storageImage[0],storageCoordinate,uvec4(1000+i));
    imageStore(storageImage[1],storageCoordinate,uvec4(2000+i));
    for(uint j=0;j<4;j++){results.value[12*i+j]=a[j];results.value[12*i+4+j]=b[j];}
    results.value[12*i+8]=x;results.value[12*i+9]=y;
    results.value[12*i+10]=i;results.value[12*i+11]=0xFACEu;
}
