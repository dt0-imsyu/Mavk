#version 450
layout(local_size_x=4) in;
layout(set=0,binding=0) uniform sampler2D source;
layout(set=0,binding=1,std430) buffer Results {uvec4 value[4];} result;
void main(){
    uint i=gl_GlobalInvocationID.x;
    vec2 uv=vec2((i&1u)==0u?0.25:0.75,(i&2u)==0u?0.25:0.75);
    result.value[i]=uvec4(roundEven(textureLod(source,uv,0.0)*255.0));
}
