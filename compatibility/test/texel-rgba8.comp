#version 450
layout(local_size_x=64) in;
#ifdef INTEGER_TEXELS
layout(set=0,binding=0) uniform usamplerBuffer source;
#else
layout(set=0,binding=0) uniform samplerBuffer source;
#endif
layout(set=0,binding=1,std430) buffer Results {uvec4 value[64];} result;
void main(){
    uint i=gl_GlobalInvocationID.x;
#ifdef INTEGER_TEXELS
    result.value[i]=texelFetch(source,int(i));
#else
    result.value[i]=uvec4(roundEven(texelFetch(source,int(i))*255.0));
#endif
}
