diff --git a/wsi/mavk_profile.hpp b/wsi/mavk_profile.hpp
new file mode 100644
index 0000000..d099b40
--- /dev/null
+++ b/wsi/mavk_profile.hpp
@@ -0,0 +1,40 @@
+#pragma once
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cstdint>
+
+namespace wsi {
+inline bool mavk_cached_readback() {
+   static const bool enabled = [] {
+      const char *p = std::getenv("MAVK_WSI_CACHED_READBACK");
+      const char *shm = std::getenv("WSI_X11_FORCE_SHM");
+      return p && std::strcmp(p, "1") == 0 && shm && std::strcmp(shm, "1") == 0;
+   }();
+   return enabled;
+}
+struct mavk_profile {
+   using clock = std::chrono::steady_clock;
+   bool enabled = [] { const char *p = std::getenv("MAVK_WSI_PROFILE"); return p && std::strcmp(p, "1") == 0; }();
+   clock::time_point since = clock::now();
+   uint64_t gpu = 0, sync = 0, map = 0, copy = 0, pacing = 0, queue = 0, frames = 0, bytes = 0;
+   clock::time_point now() const { return enabled ? clock::now() : clock::time_point{}; }
+   void add(uint64_t &sum, clock::time_point start) {
+      if (enabled) sum += static_cast<uint64_t>(std::chrono::duration_cast<std::chrono::nanoseconds>(clock::now() - start).count());
+   }
+   void finish(uint64_t copied) {
+      if (!enabled) return;
+      frames++; bytes += copied;
+      const auto end = clock::now();
+      const auto seconds = std::chrono::duration<double>(end - since).count();
+      if (seconds < 1) return;
+      std::fprintf(stderr, "MAVK_WSI_PROFILE seconds=%.3f frames=%llu gpuWaitMs=%.3f xSyncMs=%.3f mapMs=%.3f copyMs=%.3f pacingMs=%.3f xQueueMs=%.3f copiedBytes=%llu uniqueFrames=unknown\n",
+         seconds, static_cast<unsigned long long>(frames), static_cast<double>(gpu) / 1e6,
+         static_cast<double>(sync) / 1e6, static_cast<double>(map) / 1e6, static_cast<double>(copy) / 1e6,
+         static_cast<double>(pacing) / 1e6, static_cast<double>(queue) / 1e6, static_cast<unsigned long long>(bytes));
+      since = end; gpu = sync = map = copy = pacing = queue = frames = bytes = 0;
+   }
+};
+inline mavk_profile &mavk_wsi_profile() { static thread_local mavk_profile p; return p; }
+}
