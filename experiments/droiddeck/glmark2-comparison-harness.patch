+    GLExtensions::GenRenderbuffers(1, &offscreen_color_);
+    GLExtensions::BindRenderbuffer(GL_RENDERBUFFER, offscreen_color_);
+    GLExtensions::RenderbufferStorage(GL_RENDERBUFFER, GL_RGBA8, width_, height_);
+    GLExtensions::GenRenderbuffers(1, &offscreen_depth_);
+    GLExtensions::BindRenderbuffer(GL_RENDERBUFFER, offscreen_depth_);
+    GLExtensions::RenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH_COMPONENT24, width_, height_);
+    GLExtensions::GenFramebuffers(1, &offscreen_fbo_);
+    GLExtensions::BindFramebuffer(GL_FRAMEBUFFER, offscreen_fbo_);
+    GLExtensions::FramebufferRenderbuffer(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_RENDERBUFFER, offscreen_color_);
+    GLExtensions::FramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_ATTACHMENT, GL_RENDERBUFFER, offscreen_depth_);
+    if (GLExtensions::CheckFramebufferStatus(GL_FRAMEBUFFER) != GL_FRAMEBUFFER_COMPLETE || glGetError() != GL_NO_ERROR)
