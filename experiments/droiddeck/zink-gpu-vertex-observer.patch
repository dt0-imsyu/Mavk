    if (!map)
       return NULL;
    *transfer = trace_transfer_create(tr_context, resource, xfer);
+   tr_context->mavk_vertex_snapshot = debug_get_bool_option("MAVK_TRACE_VERTEX_SNAPSHOT", false);
+   if (tr_context->mavk_vertex_snapshot && resource->target == PIPE_BUFFER) {
+      for (unsigned m = 0; m < ARRAY_SIZE(tr_context->mavk_maps); m++) {
