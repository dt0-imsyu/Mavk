#version 450
layout(local_size_x=1) in;
layout(set=0,binding=0) uniform sampler2D combinedImages[2];
layout(set=0,binding=3) uniform texture2D separateImage;
layout(set=0,binding=7) uniform sampler fixedSamplers[2];
layout(set=0,binding=9,std430) buffer Result {uvec4 value[16];} result;
void main(){
    uint i=gl_GlobalInvocationID.x;
    if(i>=4)return;
    vec2 uv=vec2((i&1)!=0?1.25:-0.25,(i&2)!=0?1.25:-0.25);
    result.value[4*i+0]=uvec4(round(textureLod(combinedImages[0],uv,0)*255));
    result.value[4*i+1]=uvec4(round(textureLod(combinedImages[1],uv,0)*255));
    result.value[4*i+2]=uvec4(round(textureLod(sampler2D(separateImage,fixedSamplers[0]),uv,0)*255));
    result.value[4*i+3]=uvec4(round(textureLod(sampler2D(separateImage,fixedSamplers[1]),uv,0)*255));
}
