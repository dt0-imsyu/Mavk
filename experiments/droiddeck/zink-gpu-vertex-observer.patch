+static void
+mavk_observe_gpu_copy(struct pipe_context *pipe, struct pipe_resource *source,
+                      unsigned offset, unsigned size, const unsigned char *expected,
+                      unsigned sample, unsigned binding, bool control)
+{
+   struct pipe_resource *staging = pipe_buffer_create(pipe->screen, 0, PIPE_USAGE_STAGING, size);
+   if (!staging)
+      return;
+   struct pipe_box box = {offset, 0, 0, size, 1, 1};
+   pipe->resource_copy_region(pipe, staging, 0, 0, 0, 0, source, 0, &box);
+   struct pipe_fence_handle *fence = NULL;
+   pipe->flush(pipe, &fence, PIPE_FLUSH_HINT_FINISH);
+   bool complete = fence && pipe->screen->fence_finish(pipe->screen, pipe, fence, 5000000000ull);
+   pipe->screen->fence_reference(pipe->screen, &fence, NULL);
+   fprintf(stderr, "MAVK_GPU_VERTEX_FENCE sample=%u binding=%u control=%u complete=%u\n",
+           sample, binding, control, complete);
+   if (complete) {
+      struct pipe_transfer *transfer = NULL;
+      const unsigned char *readback = pipe_buffer_map_range(pipe, staging, 0, size, PIPE_MAP_READ, &transfer);
+      if (readback) {
+         fprintf(stderr, "MAVK_GPU_VERTEX_COPY sample=%u binding=%u control=%u bytes=%u equal=%u hex=",
+                 sample, binding, control, size, memcmp(expected, readback, size) == 0);
+         for (unsigned b = 0; b < size; b++)
+            fprintf(stderr, "%02x", readback[b]);
+         fprintf(stderr, "\n");
+         pipe_buffer_unmap(pipe, transfer);
+      } else {
+         fprintf(stderr, "MAVK_GPU_VERTEX_COPY sample=%u binding=%u control=%u map_failed=1\n",
+                 sample, binding, control);
+      }
+   }
+   pipe_resource_reference(&staging, NULL);
+}
