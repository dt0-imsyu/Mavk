#version 450
layout(local_size_x=64) in;
layout(set=0,binding=0,std430) buffer Data { uint value[128]; } dataBuffer[2];
layout(set=0,binding=1,std430) buffer Results { uint value[512]; } resultBuffer;
layout(set=0,binding=2,std140) uniform Constants { uvec4 value; } constants[2];
void main(){
    uint i=gl_GlobalInvocationID.x;
    uint absent=dataBuffer[0].value[i],present=dataBuffer[1].value[i];
    dataBuffer[0].value[i]=0xDEAD0000u+i;
    dataBuffer[1].value[i]=present+3u;
    resultBuffer.value[8*i]=absent;resultBuffer.value[8*i+1]=present;
    resultBuffer.value[8*i+2]=constants[0].value.x;resultBuffer.value[8*i+3]=constants[1].value.x;
    resultBuffer.value[8*i+4]=dataBuffer[0].value[i+64];resultBuffer.value[8*i+5]=dataBuffer[1].value[i+64];
    dataBuffer[0].value[i+64]=0xBAD00000u+i;dataBuffer[1].value[i+64]=0xBAD10000u+i;
    resultBuffer.value[8*i+6]=atomicAdd(dataBuffer[0].value[i],7u);
    resultBuffer.value[8*i+7]=atomicAdd(dataBuffer[1].value[i],9u);
}
