#version 450
layout(local_size_x=64) in;
#ifdef INTEGER_TEXELS
layout(set=0,binding=0) uniform usamplerBuffer source;
#else
layout(set=0,binding=0) uniform samplerBuffer source;
#endif
layout(set=0,binding=1,std430) buffer Results {uvec4 value[64];} result;
void main(){
    uint i=gl_GlobalInvocationID.x;
    int indices[5]=int[5](0,63,-1,64,1073741824);
#ifdef INTEGER_TEXELS
    result.value[i]=texelFetch(source,indices[i%5]);
#else
    result.value[i]=uvec4(roundEven(texelFetch(source,indices[i%5])*255.0));
#endif
}
